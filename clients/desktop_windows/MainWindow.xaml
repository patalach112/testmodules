<Window x:Class="EcosystemClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecosystem Client"
        Width="1500" Height="920"
        MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource BodyFont}">

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowDashboardCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowTerminalCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowCryptoCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!--
            Shadow pass. Kept as its own layer with nothing animated inside it, so the
            expensive DropShadowEffect is rendered once instead of on every frame of
            the live dashboard underneath.
        -->
        <Border x:Name="ShadowLayer"
                Margin="18"
                CornerRadius="22"
                Background="#FF0B0B0F">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="42" ShadowDepth="0" Opacity="0.85" />
            </Border.Effect>
        </Border>

        <!-- ======================= WINDOW SHELL ======================= -->
        <Border x:Name="WindowShell"
                Margin="18"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="#3322D3EE"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0C0C12" Offset="0" />
                    <GradientStop Color="#FF0A0A10" Offset="0.55" />
                    <GradientStop Color="#FF101018" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Ambient neon blooms: static gradients, only their opacity animates. -->
                <Grid IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-260,-320,0,0" Fill="{StaticResource CyanBloomBrush}" Opacity="0.55">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.55" To="0.2" Duration="0:0:14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-180,-260" Fill="{StaticResource PurpleBloomBrush}" Opacity="0.45">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.45" To="0.15" Duration="0:0:18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,-260,0,0" Fill="{StaticResource MagentaBloomBrush}" Opacity="0.3" />
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <!-- ======================= TITLE BAR ======================= -->
                    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                          MouseLeftButtonDown="OnTitleBarMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="20,0,0,0">
                            <Border Width="32" Height="32" CornerRadius="10"
                                    Background="{StaticResource AccentGradientBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="18"
                                                      ShadowDepth="0" Opacity="0.85" />
                                </Border.Effect>
                                <Path Data="M12,2 L20.66,7 L20.66,17 L12,22 L3.34,17 L3.34,7 Z M12,8.6 L9.4,11.2 L12,13.8 L14.6,11.2 Z"
                                      Stretch="Uniform" Width="18" Height="18"
                                      Fill="#FF070F14" />
                            </Border>

                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ECOSYSTEM"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="13.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="DESKTOP CLIENT · WINDOWS"
                                           Style="{StaticResource EyebrowStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Live status pill -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Style="{StaticResource StatusPillStyle}"
                                Background="#1414141E"
                                BorderBrush="{Binding Session.State, Converter={StaticResource StateBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding Session.State, Converter={StaticResource StateBrush}}" />
                                    <Ellipse Width="7" Height="7" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                             Stroke="{Binding Session.State, Converter={StaticResource StateBrush}}"
                                             StrokeThickness="1.4">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.85" To="0" Duration="0:0:2.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1" To="2.6" Duration="0:0:2.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1" To="2.6" Duration="0:0:2.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding Session.StateLabel}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="10.5" FontWeight="Bold"
                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Session.State, Converter={StaticResource StateBrush}}" />
                                <Border Width="1" Height="12" Margin="12,0" Background="#33FFFFFF" />
                                <TextBlock Text="{Binding Session.Settings.Endpoint}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           MaxWidth="330"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Clock + window controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <TextBlock Text="{Binding ClockText}"
                                       Style="{StaticResource MonoTextStyle}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Click="OnMinimizeClick"
                                    ToolTip="Minimize to taskbar">
                                <Path Data="M1,8 H13" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                            </Button>

                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="OnMaximizeRestoreClick"
                                    ToolTip="Maximize / restore">
                                <Grid Width="14" Height="14">
                                    <Path x:Name="MaximizeGlyph"
                                          Data="M1.5,1.5 H12.5 V12.5 H1.5 Z"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.3" Stretch="Uniform" />
                                    <Path x:Name="RestoreGlyph"
                                          Data="M4,1 H13 V10 M1,4 H10 V13 H1 Z"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.3" Stretch="Uniform"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource CloseButtonStyle}"
                                    Click="OnCloseClick"
                                    ToolTip="Close">
                                <Path Data="M1.5,1.5 L12.5,12.5 M12.5,1.5 L1.5,12.5"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ========================= BODY ========================= -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="262" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ========== SIDEBAR ========== -->
                        <Border Grid.Column="0" BorderThickness="0,1,1,0" BorderBrush="#26FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0D0D13" Offset="0" />
                                    <GradientStop Color="#FF0A0A10" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="NAVIGATION"
                                               Style="{StaticResource EyebrowStyle}"
                                               Margin="24,20,0,6" />
                                    <Border Height="1" Margin="24,0,24,10" Background="#1AFFFFFF" />
                                    <ListBox Style="{StaticResource NavListStyle}"
                                             ItemsSource="{Binding Pages}"
                                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Native core / session card -->
                                <Border Grid.Row="1" VerticalAlignment="Bottom"
                                        Style="{StaticResource CardBorderStyle}"
                                        CornerRadius="14"
                                        Margin="14,16,14,14"
                                        Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{StaticResource GreenBrush}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="{StaticResource ColorGreen}"
                                                                      BlurRadius="10" ShadowDepth="0"
                                                                      Opacity="0.9" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="CRYPTO CORE"
                                                       Style="{StaticResource EyebrowStyle}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Crypto.BackendText}"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   FontSize="11.5"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <TextBlock Text="{Binding Crypto.LibraryPathText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="10"
                                                   Margin="0,6,0,0"
                                                   MaxHeight="30"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextMutedBrush}" />

                                        <Border Style="{StaticResource DividerStyle}" Margin="0,12,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ops (native / managed)"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="10" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Crypto.OpsText}"
                                                       Style="{StaticResource MonoTextStyle}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource CyanBrush}" />
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="bytes transformed"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="10" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Crypto.VolumeText}"
                                                       Style="{StaticResource MonoTextStyle}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource PurpleBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ========== CONTENT ========== -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Page header -->
                            <Grid Grid.Row="0" Margin="26,20,26,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HeaderIndex}"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource CyanBrush}" />
                                        <Border Width="22" Height="1" Margin="10,0"
                                                Background="{StaticResource AccentLineBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Session.StateDetail}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding HeaderTitle}"
                                               Style="{StaticResource DisplayTitleStyle}"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding HeaderSubtitle}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding Session.ReconnectCommand}"
                                            Margin="0,0,10,0"
                                            Content="RECONNECT" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding ClearLogsCommand}"
                                            Margin="0,0,10,0"
                                            Content="CLEAR LOG" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding Session.ConnectCommand}"
                                            Content="CONNECT"
                                            Visibility="{Binding Session.IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding Session.DisconnectCommand}"
                                            Content="DISCONNECT"
                                            Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Active page -->
                            <ContentControl Grid.Row="1"
                                            Content="{Binding SelectedPage}"
                                            Margin="26,0,26,18"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                        </Grid>
                    </Grid>

                    <!-- ======================= STATUS BAR ======================= -->
                    <Border Grid.Row="2" Background="#FF09090D"
                            BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF"
                            CornerRadius="0,0,19,19">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{Binding Session.State, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding Session.StateLabel}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="·"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Session.Settings.Endpoint}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           MaxWidth="380"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Session.StateDetail}"
                                       Style="{StaticResource MonoTextStyle}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BuildLabel}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Border Width="1" Height="10" Margin="12,0" Background="#26FFFFFF" />
                                <TextBlock Text="{Binding Crypto.BackendText}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="10"
                                           Foreground="{StaticResource PurpleBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

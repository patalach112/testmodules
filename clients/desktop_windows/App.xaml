<Application x:Class="EcosystemClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcosystemClient.Converters"
             xmlns:vm="clr-namespace:EcosystemClient"
             xmlns:views="clr-namespace:EcosystemClient.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                =================================================================
                ECOSYSTEM CLIENT · DESIGN SYSTEM
                =================================================================
                Deep-space dark theme with cyan/purple neon accents.

                Layering rules used throughout the app:
                  · #0B0B0F  window canvas (the void)
                  · #14141C  panels
                  · #1A1A24  raised cards / inputs
                  · #2A2A3A  hairlines
                Accents are used sparingly and always with a matching glow.
                =================================================================
            -->

            <!-- ============================ COLORS ============================ -->
            <Color x:Key="ColorVoid">#FF08080C</Color>
            <Color x:Key="ColorBgDeep">#FF0B0B0F</Color>
            <Color x:Key="ColorBgPanel">#FF14141C</Color>
            <Color x:Key="ColorBgPanelAlt">#FF1A1A24</Color>
            <Color x:Key="ColorBgElevated">#FF1F1F2B</Color>
            <Color x:Key="ColorBorder">#FF2A2A3A</Color>
            <Color x:Key="ColorBorderSoft">#FF212130</Color>
            <Color x:Key="ColorTextPrimary">#FFEDEDF5</Color>
            <Color x:Key="ColorTextSecondary">#FFA5A5BC</Color>
            <Color x:Key="ColorTextMuted">#FF6A6A82</Color>
            <Color x:Key="ColorCyan">#FF22D3EE</Color>
            <Color x:Key="ColorTeal">#FF2DD4BF</Color>
            <Color x:Key="ColorPurple">#FFA855F7</Color>
            <Color x:Key="ColorMagenta">#FFF472B6</Color>
            <Color x:Key="ColorGreen">#FF34D399</Color>
            <Color x:Key="ColorAmber">#FFFBBF24</Color>
            <Color x:Key="ColorRed">#FFF87171</Color>
            <Color x:Key="ColorBlue">#FF60A5FA</Color>

            <!-- ============================ BRUSHES =========================== -->
            <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource ColorBgDeep}" />
            <SolidColorBrush x:Key="BgVoidBrush" Color="{StaticResource ColorVoid}" />
            <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource ColorBgPanel}" />
            <SolidColorBrush x:Key="BgPanelAltBrush" Color="{StaticResource ColorBgPanelAlt}" />
            <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource ColorBgElevated}" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource ColorBorderSoft}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
            <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}" />
            <SolidColorBrush x:Key="TealBrush" Color="{StaticResource ColorTeal}" />
            <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource ColorPurple}" />
            <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource ColorMagenta}" />
            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}" />
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource ColorAmber}" />
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ColorRed}" />
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource ColorBlue}" />

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource ColorCyan}" Offset="0" />
                <GradientStop Color="{StaticResource ColorPurple}" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0022D3EE" Offset="0" />
                <GradientStop Color="{StaticResource ColorCyan}" Offset="0.35" />
                <GradientStop Color="{StaticResource ColorPurple}" Offset="0.7" />
                <GradientStop Color="#00A855F7" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="0.7,1">
                <GradientStop Color="#FF171720" Offset="0" />
                <GradientStop Color="#FF111119" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Color="#FF1B1B26" Offset="0" />
                <GradientStop Color="#FF13131B" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3322D3EE" Offset="0" />
                <GradientStop Color="#1AA855F7" Offset="0.55" />
                <GradientStop Color="#0AF472B6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1AFFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.6" />
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="CyanBloomBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#5522D3EE" Offset="0" />
                <GradientStop Color="#1A22D3EE" Offset="0.45" />
                <GradientStop Color="#0022D3EE" Offset="1" />
            </RadialGradientBrush>

            <RadialGradientBrush x:Key="PurpleBloomBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#55A855F7" Offset="0" />
                <GradientStop Color="#1AA855F7" Offset="0.5" />
                <GradientStop Color="#00A855F7" Offset="1" />
            </RadialGradientBrush>

            <RadialGradientBrush x:Key="MagentaBloomBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#40F472B6" Offset="0" />
                <GradientStop Color="#00F472B6" Offset="1" />
            </RadialGradientBrush>

            <!-- ============================ FONTS ============================= -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Tahoma</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code, Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- =========================== EFFECTS ============================ -->
            <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource ColorCyan}" BlurRadius="22" ShadowDepth="0" Opacity="0.75" />
            <DropShadowEffect x:Key="PurpleGlow" Color="{StaticResource ColorPurple}" BlurRadius="24" ShadowDepth="0" Opacity="0.7" />
            <DropShadowEffect x:Key="GreenGlow" Color="{StaticResource ColorGreen}" BlurRadius="18" ShadowDepth="0" Opacity="0.7" />
            <DropShadowEffect x:Key="PanelShadow" Color="#FF000000" BlurRadius="26" ShadowDepth="10" Opacity="0.55" />
            <DropShadowEffect x:Key="WindowShadow" Color="#FF000000" BlurRadius="34" ShadowDepth="0" Opacity="0.85" />

            <!-- ========================== CONVERTERS ========================== -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
            <conv:QualityToBrushConverter x:Key="QualityBrush" />
            <conv:NetworkStateToBrushConverter x:Key="StateBrush" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityInverted" Invert="True" />

            <!-- ========================== TYPOGRAPHY ========================== -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <Style x:Key="DisplayTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <!-- ============================ SURFACES =========================== -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="ElevatedCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
            </Style>

            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="Margin" Value="0,10" />
            </Style>

            <Style x:Key="StatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- ============================ SCROLLBAR ========================== -->
            <Style x:Key="SlimScrollPageButtonStyle" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBody" CornerRadius="4" Background="#FF33334A" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="#FF22D3EE" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="#FFA855F7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreasePage"
                                                      Command="ScrollBar.PageUpCommand"
                                                      Style="{StaticResource SlimScrollPageButtonStyle}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollThumbStyle}" Margin="1,2" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreasePage"
                                                      Command="ScrollBar.PageDownCommand"
                                                      Style="{StaticResource SlimScrollPageButtonStyle}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="8" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                    <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                    <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />

            <!-- ============================= BUTTONS =========================== -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="10" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF17171F" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#FF2A2A3A" />
                                    </Border.BorderBrush>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Halo" CornerRadius="10" IsHitTestVisible="False" Opacity="0"
                                        BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#8022D3EE" />
                                    </Border.BorderBrush>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Halo"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.18" />
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF1F1F2C" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Halo"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF17171F" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Shell" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FF06131A" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="GlowRing" CornerRadius="12" Background="{StaticResource CyanBrush}"
                                        Opacity="0.22" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="26"
                                                          ShadowDepth="0" Opacity="1" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="Surface" CornerRadius="11" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF2DE2F5" Offset="0" />
                                            <GradientStop Color="#FF35D6E8" Offset="0.45" />
                                            <GradientStop Color="#FFA855F7" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#66FFFFFF" />
                                    </Border.BorderBrush>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GlowRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.55" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GlowRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.22" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Surface"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.972" Duration="0:0:0.07" />
                                                <DoubleAnimation Storyboard.TargetName="Surface"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.972" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Surface"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="Surface"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="9">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0012121A" />
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF232333" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#0012121A" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window chrome buttons ======================================== -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0012121A" />
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF242436" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#0012121A" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0012121A" />
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFD93B3B" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Shell"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#0012121A" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================= INPUTS =========================== -->
            <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource PurpleBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="10" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF12121A" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#FF2A2A3A" />
                                    </Border.BorderBrush>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  Focusable="False" />
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{StaticResource CyanBrush}" Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="#FF3A3A50" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Multi-line variant: same shell, scrolling content host. -->
            <Style x:Key="MultilineFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Shell" CornerRadius="10" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF10101A" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#FF2A2A3A" />
                                    </Border.BorderBrush>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False" />
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{StaticResource CyanBrush}" Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="#FF232332" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwitchCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Track" Width="40" Height="21" CornerRadius="11" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF1C1C26" />
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#FF2E2E40" />
                                    </Border.BorderBrush>
                                    <Border x:Name="Knob" Width="15" Height="15" CornerRadius="8"
                                            HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="#FF6A6A82" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF22D3EE" Duration="0:0:0.16" />
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFFFFFFF" Duration="0:0:0.16" />
                                                <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                    Storyboard.TargetProperty="Margin"
                                                                    To="22,0,0,0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF1C1C26" Duration="0:0:0.16" />
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF6A6A82" Duration="0:0:0.16" />
                                                <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                    Storyboard.TargetProperty="Margin"
                                                                    To="3,0,0,0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#FF3E3E56" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- =========================== NAVIGATION ========================= -->
            <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Margin="10,2">
                                <Border x:Name="Surface" CornerRadius="12">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0014141C" />
                                    </Border.Background>
                                </Border>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                            Background="{StaticResource AccentGradientBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="12"
                                                              ShadowDepth="0" Opacity="1" />
                                        </Border.Effect>
                                    </Border>
                                    <Path x:Name="Glyph" Grid.Column="1" Width="19" Height="19"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Uniform" StrokeThickness="1.6"
                                          Stroke="{StaticResource TextMutedBrush}"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{Binding IconData}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,10,12,10">
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Surface"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF1A1A26" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Surface"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#0014141C" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="Surface"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FF20202E" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource CyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource NavItemStyle}" />
            </Style>

            <!-- ============================ TERMINAL ========================== -->
            <Style x:Key="TerminalItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="14,3">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#1A22D3EE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TerminalListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TerminalItemStyle}" />
            </Style>

            <!-- ====================== PAGE DATA TEMPLATES ===================== -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
                <views:TerminalView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CryptoViewModel}">
                <views:CryptoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>

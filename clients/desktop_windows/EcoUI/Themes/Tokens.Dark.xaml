<!--
    EcoUI · Dark tokens

    The complete, minimal set of semantic design tokens. Every colour used by
    EcoUI resolves through one of these keys, which is what lets ThemeEngine
    swap the whole look at runtime.

    Rules of the set:
      · keys are semantic (surfaces / borders / text / accent / status), never
        named after a colour, so a light and a dark variant stay interchangeable
      · Tokens.Light.xaml declares exactly the same keys
      · controls reference these with DynamicResource, so swapping the merged
        dictionary repaints live
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== surfaces ============================== -->
    <SolidColorBrush x:Key="Eco.Surface.Window" Color="#FF15171C" />
    <SolidColorBrush x:Key="Eco.Surface.Panel" Color="#FF1B1E24" />
    <SolidColorBrush x:Key="Eco.Surface.Raised" Color="#FF22262E" />
    <SolidColorBrush x:Key="Eco.Surface.Sunken" Color="#FF13151A" />
    <SolidColorBrush x:Key="Eco.Surface.Hover" Color="#FF242833" />
    <SolidColorBrush x:Key="Eco.Surface.Pressed" Color="#FF2C3140" />

    <!-- =============================== borders ============================== -->
    <SolidColorBrush x:Key="Eco.Border" Color="#FF2A2F39" />
    <SolidColorBrush x:Key="Eco.Border.Strong" Color="#FF3A4150" />
    <SolidColorBrush x:Key="Eco.Border.Subtle" Color="#FF23272F" />

    <!-- ================================ text ================================ -->
    <SolidColorBrush x:Key="Eco.Text.Primary" Color="#FFE8EAEE" />
    <SolidColorBrush x:Key="Eco.Text.Secondary" Color="#FFA7AEBC" />
    <SolidColorBrush x:Key="Eco.Text.Muted" Color="#FF6F7787" />
    <SolidColorBrush x:Key="Eco.Text.Inverse" Color="#FF0E1014" />

    <!-- =============================== accent ===============================
         Defaults only: ThemeEngine.Apply(theme, accent) overwrites these four
         keys with the selected accent ramp. -->
    <SolidColorBrush x:Key="Eco.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="Eco.Accent.Hover" Color="#FF5B9BFF" />
    <SolidColorBrush x:Key="Eco.Accent.Pressed" Color="#FF2A62C4" />
    <SolidColorBrush x:Key="Eco.Accent.Soft" Color="#FF1E2A3F" />
    <SolidColorBrush x:Key="Eco.OnAccent" Color="#FFFFFFFF" />

    <!-- =============================== status =============================== -->
    <SolidColorBrush x:Key="Eco.Success" Color="#FF3DD68C" />
    <SolidColorBrush x:Key="Eco.Success.Soft" Color="#FF1B3A2C" />
    <SolidColorBrush x:Key="Eco.Warning" Color="#FFF0B429" />
    <SolidColorBrush x:Key="Eco.Warning.Soft" Color="#FF3A2E12" />
    <SolidColorBrush x:Key="Eco.Error" Color="#FFF26D6D" />
    <SolidColorBrush x:Key="Eco.Error.Soft" Color="#FF3A1D1D" />
    <SolidColorBrush x:Key="Eco.Info" Color="#FF63A8FF" />
    <SolidColorBrush x:Key="Eco.Info.Soft" Color="#FF18283F" />
    <SolidColorBrush x:Key="Eco.Idle" Color="#FF8891A3" />
    <SolidColorBrush x:Key="Eco.Idle.Soft" Color="#FF23272F" />

    <!-- =========================== typography =============================== -->
    <FontFamily x:Key="Eco.Font.Ui">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Eco.Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Eco.Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>

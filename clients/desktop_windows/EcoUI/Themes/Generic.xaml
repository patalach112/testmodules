<!--
    EcoUI · Default control templates

    This is WPF's theme dictionary: it is discovered automatically through the
    ThemeInfo attribute, and supplies the default style for every EcoUI control
    (matched on DefaultStyleKey). That means the controls render correctly even if
    a consumer never calls ThemeEngine.Apply().

    Tokens.Dark is merged here purely as a fallback: ThemeEngine merges the selected
    token dictionary into Application.Resources, which outranks theme dictionaries,
    so the requested theme wins.

    All colours are DynamicResource lookups so a theme swap repaints live.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:eco="clr-namespace:EcoUI"
                    xmlns:controls="clr-namespace:EcoUI.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EcoUI;component/Themes/Tokens.Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== WINDOW CHROME BUTTONS ==================== -->
    <Style x:Key="Eco.CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Eco.Text.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Eco.Surface.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Eco.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Eco.Surface.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The conventional window-close red is theme-independent on Windows. -->
    <Style x:Key="Eco.CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Eco.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F1707A" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================== ECO WINDOW ========================== -->
    <Style TargetType="{x:Type eco:EcoWindow}">
        <Setter Property="Background" Value="{DynamicResource Eco.Surface.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Eco.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Eco.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type eco:EcoWindow}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Eco.Border}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Title bar. Its height doubles as WindowChrome.CaptionHeight,
                                 which is what gives it native drag / snap / double-click. -->
                            <Border x:Name="TitleBar"
                                    Grid.Row="0"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="{DynamicResource Eco.Surface.Panel}"
                                    BorderBrush="{DynamicResource Eco.Border}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="14,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   MaxWidth="520"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Eco.Text.Primary}" />
                                        <ContentPresenter Grid.Column="1"
                                                          Content="{TemplateBinding TitleBarContent}"
                                                          Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                                    </Grid>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button x:Name="PART_MinimizeButton"
                                                Style="{StaticResource Eco.CaptionButton}"
                                                ToolTip="Minimize">
                                            <Path Data="M1,5 H11"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                        </Button>

                                        <Button x:Name="PART_MaximizeButton"
                                                Style="{StaticResource Eco.CaptionButton}"
                                                ToolTip="Maximize or restore">
                                            <Grid>
                                                <Path x:Name="MaximizeGlyph"
                                                      Data="M1.5,1.5 H10.5 V10.5 H1.5 Z"
                                                      StrokeThickness="1.2"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                <Path x:Name="RestoreGlyph"
                                                      Data="M3,1 H11 V9 M1,3 H9 V11 H1 Z"
                                                      StrokeThickness="1.2"
                                                      Visibility="Collapsed"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                            </Grid>
                                        </Button>

                                        <Button x:Name="PART_CloseButton"
                                                Style="{StaticResource Eco.CloseButton}"
                                                ToolTip="Close">
                                            <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsTitleBarVisible" Value="False">
                            <Setter TargetName="TitleBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMaximized" Value="True">
                            <Setter TargetName="MaximizeGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== ECO TERMINAL ==========================
         The ScrollViewer (PART_Scroller) drives tail-following from code; the
         VirtualizingStackPanel keeps the visual tree proportional to the viewport,
         not to the buffer. -->
    <Style TargetType="{x:Type controls:EcoTerminal}">
        <Setter Property="Background" Value="{DynamicResource Eco.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Eco.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EcoTerminal}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_Scroller"
                                      Margin="{TemplateBinding Padding}"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{TemplateBinding Entries}"
                                          Focusable="False"
                                          FontFamily="{DynamicResource Eco.Font.Mono}"
                                          FontSize="12"
                                          TextOptions.TextFormattingMode="Display">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Time"
                                                       Grid.Column="0"
                                                       Text="{Binding TimeText}"
                                                       Margin="0,0,10,0"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Eco.Text.Muted}" />
                                            <TextBlock x:Name="Level"
                                                       Grid.Column="1"
                                                       Text="{Binding LevelTag}"
                                                       Margin="0,0,10,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Eco.Text.Secondary}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Eco.Text.Primary}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ShowTimestamps, RelativeSource={RelativeSource AncestorType={x:Type controls:EcoTerminal}}}"
                                                         Value="False">
                                                <Setter TargetName="Time" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:EcoLogLevel.Success}">
                                                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Eco.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:EcoLogLevel.Warning}">
                                                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Eco.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:EcoLogLevel.Error}">
                                                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Eco.Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:EcoLogLevel.Debug}">
                                                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Eco.Text.Muted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== ECO STAT CARD ========================== -->
    <Style TargetType="{x:Type controls:EcoStatCard}">
        <Setter Property="Background" Value="{DynamicResource Eco.Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Eco.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EcoStatCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Eco.Text.Secondary}" />
                            <TextBlock Text="{TemplateBinding Value}"
                                       Margin="0,6,0,0"
                                       FontFamily="{DynamicResource Eco.Font.Display}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Eco.Text.Primary}" />
                            <TextBlock Text="{TemplateBinding Subtext}"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Eco.Text.Muted}" />
                            <Border x:Name="TrendChip"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource Eco.Idle.Soft}">
                                <TextBlock x:Name="TrendLabel"
                                           Text="{TemplateBinding Trend}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Eco.Idle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasTrend" Value="True">
                            <Setter TargetName="TrendChip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TrendKind" Value="{x:Static controls:EcoTrendKind.Positive}">
                            <Setter TargetName="TrendChip" Property="Background" Value="{DynamicResource Eco.Success.Soft}" />
                            <Setter TargetName="TrendLabel" Property="Foreground" Value="{DynamicResource Eco.Success}" />
                        </Trigger>
                        <Trigger Property="TrendKind" Value="{x:Static controls:EcoTrendKind.Negative}">
                            <Setter TargetName="TrendChip" Property="Background" Value="{DynamicResource Eco.Error.Soft}" />
                            <Setter TargetName="TrendLabel" Property="Foreground" Value="{DynamicResource Eco.Error}" />
                        </Trigger>
                        <Trigger Property="TrendKind" Value="{x:Static controls:EcoTrendKind.Neutral}">
                            <Setter TargetName="TrendChip" Property="Background" Value="{DynamicResource Eco.Info.Soft}" />
                            <Setter TargetName="TrendLabel" Property="Foreground" Value="{DynamicResource Eco.Info}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================= ECO STATUS BADGE ========================= -->
    <Style TargetType="{x:Type controls:EcoStatusBadge}">
        <Setter Property="FontFamily" Value="{DynamicResource Eco.Font.Ui}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EcoStatusBadge}">
                    <Border x:Name="Pill"
                            HorizontalAlignment="Left"
                            CornerRadius="9"
                            Padding="8,3"
                            Background="{DynamicResource Eco.Idle.Soft}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot"
                                     Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Eco.Idle}" />
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Text}"
                                       Margin="7,0,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Eco.Idle}" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- No label: collapse it and rebalance the pill padding so the
                             dot stays visually centred. -->
                        <Trigger Property="HasText" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pill" Property="Padding" Value="5,4" />
                        </Trigger>
                        <Trigger Property="ShowText" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pill" Property="Padding" Value="5,4" />
                        </Trigger>

                        <Trigger Property="Status" Value="{x:Static controls:EcoStatus.Info}">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Eco.Info.Soft}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Eco.Info}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Eco.Info}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:EcoStatus.Success}">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Eco.Success.Soft}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Eco.Success}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Eco.Success}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:EcoStatus.Warning}">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Eco.Warning.Soft}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Eco.Warning}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Eco.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:EcoStatus.Error}">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Eco.Error.Soft}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Eco.Error}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Eco.Error}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<UserControl x:Class="EcosystemClient.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ TOOLBAR ============================ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <TextBox x:Name="FilterBox"
                             Style="{StaticResource FieldTextBoxStyle}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,9"
                             FontFamily="{StaticResource BodyFont}" />
                    <TextBlock Text="filter · level, category or payload text"
                               IsHitTestVisible="False"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding FilterText, Converter={StaticResource EmptyStringToVisibilityInverted}}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Content="traffic"
                              IsChecked="{Binding ShowTraffic}" Margin="0,0,16,0" />
                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Content="system"
                              IsChecked="{Binding ShowSystem}" Margin="0,0,16,0" />
                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Content="debug"
                              IsChecked="{Binding ShowDiagnostics}" Margin="0,0,16,0" />
                    <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Content="follow"
                              IsChecked="{Binding AutoScroll}" Margin="0,0,16,0" />

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding TogglePauseCommand}"
                            ToolTip="Pause / resume capture">
                        <Path Data="M3,2 H6 V14 H3 Z M10,2 H13 V14 H10 Z"
                              Fill="{StaticResource AmberBrush}" Width="12" Height="12"
                              Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding CopyCommand}"
                            ToolTip="Copy visible lines">
                        <Path Data="M4,1 H11 V4 M1,4 H9 V14 H1 Z M4,7 H13 V17 H4"
                              Stroke="{StaticResource CyanBrush}" StrokeThickness="1.4"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ClearCommand}"
                            ToolTip="Clear buffer">
                        <Path Data="M2,4 H14 M6,4 V2 H10 V4 M4,4 L5,15 H11 L12,4"
                              Stroke="{StaticResource RedBrush}" StrokeThickness="1.4"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= LOG VIEW =========================== -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0,10,0,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{StaticResource GreenBrush}" />
                        <TextBlock Text="WIRE LOG" Style="{StaticResource EyebrowStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Border Width="1" Height="10" Margin="12,0" Background="#26FFFFFF" />
                        <TextBlock Text="{Binding CounterText}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                               Style="{StaticResource MonoTextStyle}" FontSize="10"
                               Foreground="{StaticResource CyanBrush}" />
                </Grid>

                <ListBox x:Name="LogList" Grid.Row="1"
                         Style="{StaticResource TerminalListStyle}"
                         ItemsSource="{Binding EntriesView}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           Style="{StaticResource MonoTextStyle}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelTag}"
                                           Style="{StaticResource MonoTextStyle}" FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding CategoryText}"
                                           Style="{StaticResource MonoTextStyle}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           Style="{StaticResource MonoTextStyle}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- =========================== COMMAND BAR ========================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="›"
                           FontFamily="{StaticResource MonoFont}" FontSize="18"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           Foreground="{StaticResource CyanBrush}" />

                <TextBox Grid.Column="1" Grid.Row="0" x:Name="CommandBox"
                         Style="{StaticResource FieldTextBoxStyle}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource MonoFont}"
                         Padding="12,9">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SendCommand}" Content="SEND" Margin="10,0,0,0" />

                <Button Grid.Column="3" Grid.Row="0" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding SendPingCommand}" Content="PING" Margin="8,0,0,0" />

                <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                           Text="{Binding SendHint}"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="10" Margin="2,8,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

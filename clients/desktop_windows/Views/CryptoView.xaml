<UserControl x:Class="EcosystemClient.Views.CryptoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= TRANSFORM PLAYGROUND ====================== -->
        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}"
                Margin="0,0,14,0" Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="TRANSFORM PLAYGROUND" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Center" />
                    <Border Width="26" Height="1" Margin="10,0"
                            Background="{StaticResource AccentLineBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="asm_crypto_xor" Style="{StaticResource MonoTextStyle}"
                               FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource CyanBrush}" />
                </StackPanel>

                <!-- Key -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="64-BIT KEY (MATCHES THE GATEWAY ASM_CRYPTO_KEY)"
                                   Style="{StaticResource EyebrowStyle}" FontSize="9"
                                   Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                 Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="PARSED" Style="{StaticResource EyebrowStyle}" FontSize="9"
                                   Margin="0,0,0,8" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource StatusPillStyle}" Padding="12,8"
                                Background="#1414141E" BorderBrush="{StaticResource PurpleBrush}">
                            <TextBlock Text="{Binding KeyPreview}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="11" Foreground="{StaticResource PurpleBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Plaintext input -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="PLAINTEXT INPUT" Style="{StaticResource EyebrowStyle}" FontSize="9"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource MultilineFieldTextBoxStyle}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="90" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,14">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding TransformCommand}" Content="TRANSFORM" />
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SwapCommand}" Content="LOAD CIPHERTEXT" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MonoTextStyle}"
                               FontSize="10.5" VerticalAlignment="Center" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- Ciphertext output -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="CIPHERTEXT / WIRE BYTES" Style="{StaticResource EyebrowStyle}" FontSize="9"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource MultilineFieldTextBoxStyle}"
                             Text="{Binding CipherHex, Mode=OneWay}"
                             IsReadOnly="True"
                             MinHeight="90"
                             Foreground="{StaticResource CyanBrush}" />
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RoundTripText}" Style="{StaticResource MonoTextStyle}"
                               FontSize="10.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource GreenBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding ArchitectureText}"
                               Style="{StaticResource MonoTextStyle}" FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ CORE STATUS ========================== -->
        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="CORE STATUS" Style="{StaticResource EyebrowStyle}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource StatusPillStyle}" Padding="8,2" Margin="10,0,0,0"
                            Background="#1414141E">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF34D399" />
                        </Border.BorderBrush>
                        <TextBlock Text="{Binding BackendText}" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource GreenBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="library" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{Binding LibraryVersionText}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="native ops" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{Binding OpsText}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="11"
                                   Foreground="{StaticResource CyanBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="managed ops" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{Binding ManagedOpsText}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="11"
                                   Foreground="{StaticResource PurpleBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="bytes transformed" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Border Style="{StaticResource DividerStyle}" Margin="0,8,0,10" />

                    <TextBlock Text="RESOLVED PATH" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                    <TextBlock Text="{Binding LibraryPathText}" Style="{StaticResource MonoTextStyle}"
                               FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== SELF-TEST + BENCHMARK ======================== -->
        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PARITY SELF-TEST" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding SelfTestText}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource GreenBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SelfTestCommand}" Content="RUN"
                            VerticalAlignment="Center" Padding="14,7" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource DividerStyle}" Margin="0,12" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="PIPELINE" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                        <TextBlock Text="{Binding PipelineThroughputText}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="13" Margin="0,5,0,0"
                                   Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="MANAGED" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                        <TextBlock Text="{Binding ManagedThroughputText}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="13" Margin="0,5,0,0"
                                   Foreground="{StaticResource PurpleBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="SPEEDUP" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                        <TextBlock Text="{Binding SpeedupText}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="13" Margin="0,5,0,0"
                                   Foreground="{StaticResource MagentaBrush}" />
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding BenchmarkCommand}" Content="BENCH"
                            VerticalAlignment="Center" Padding="16,9" />

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="4 MiB buffer · 24 iterations · measured on this machine"
                               Style="{StaticResource MutedTextStyle}" FontSize="9.5"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="EcosystemClient.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EcosystemClient.Controls"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.35*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- ============================ KPI STRIP ============================ -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,16">

            <!-- Latency -->
            <Border Style="{StaticResource ElevatedCardBorderStyle}" Margin="0,0,12,0" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ROUND-TRIP LATENCY" Style="{StaticResource EyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="ms" Style="{StaticResource MonoTextStyle}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,7"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource StatusPillStyle}"
                                HorizontalAlignment="Left"
                                Padding="9,3" Margin="0,10,0,0"
                                Background="#1414141E"
                                BorderBrush="{Binding LatencyQuality, Converter={StaticResource QualityBrush}}">
                            <TextBlock Text="{Binding LatencyQuality}"
                                       FontSize="9.5" FontWeight="Bold"
                                       Foreground="{Binding LatencyQuality, Converter={StaticResource QualityBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding LatencyPeakText}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <controls:RingGauge Grid.Column="1" Width="76" Height="76"
                                        VerticalAlignment="Center"
                                        Value="{Binding LatencyGauge}"
                                        Thickness="5"
                                        TrackBrush="#FF232333"
                                        ProgressBrush="{StaticResource CyanBrush}" />
                </Grid>
            </Border>

            <!-- Packet rate -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PACKET RATE" Style="{StaticResource EyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ReceivedRateText}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="pkt/s in" Style="{StaticResource MonoTextStyle}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,7"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource PurpleBrush}" />
                            <TextBlock Text="out" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SentRateText}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="11" Foreground="{StaticResource PurpleBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PacketsTotalText}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <controls:RingGauge Grid.Column="1" Width="76" Height="76"
                                        VerticalAlignment="Center"
                                        Value="{Binding PacketGauge}"
                                        Thickness="5"
                                        TrackBrush="#FF232333"
                                        ProgressBrush="{StaticResource TealBrush}" />
                </Grid>
            </Border>

            <!-- Throughput -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="THROUGHPUT" Style="{StaticResource EyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ThroughputInText}" Style="{StaticResource MetricValueStyle}"
                                       FontSize="27" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource PurpleBrush}" />
                            <TextBlock Text="out" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThroughputOutText}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="11" Foreground="{StaticResource PurpleBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThroughputTotalText}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <controls:RingGauge Grid.Column="1" Width="76" Height="76"
                                        VerticalAlignment="Center"
                                        Value="{Binding ThroughputGauge}"
                                        Thickness="5"
                                        TrackBrush="#FF232333"
                                        ProgressBrush="{StaticResource PurpleBrush}" />
                </Grid>
            </Border>

            <!-- Crypto -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CRYPTO OPS" Style="{StaticResource EyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CryptoRateText}" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="ops/s" Style="{StaticResource MonoTextStyle}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,7"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource MagentaBrush}" />
                            <TextBlock Text="{Binding CryptoBackendText}" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CryptoVolumeText}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <controls:RingGauge Grid.Column="1" Width="76" Height="76"
                                        VerticalAlignment="Center"
                                        Value="{Binding CryptoGauge}"
                                        Thickness="5"
                                        TrackBrush="#FF232333"
                                        ProgressBrush="{StaticResource MagentaBrush}" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ========================== CHARTS ROW ============================ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Throughput history -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TRANSPORT THROUGHPUT" Style="{StaticResource EyebrowStyle}"
                                       VerticalAlignment="Center" />
                            <Border Width="26" Height="1" Margin="10,0"
                                    Background="{StaticResource AccentLineBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="live" Style="{StaticResource MonoTextStyle}" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="10"
                                                      ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="inbound" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PurpleBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="outbound" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.4*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <controls:SparklineChart Grid.Row="0" Height="Auto" MinHeight="58"
                                                 Values="{Binding ThroughputInHistory}"
                                                 Stroke="{StaticResource CyanBrush}"
                                                 StrokeThickness="2" />
                        <controls:SparklineChart Grid.Row="1" MinHeight="42" Margin="0,8,0,0"
                                                 Values="{Binding ThroughputOutHistory}"
                                                 Stroke="{StaticResource PurpleBrush}"
                                                 StrokeThickness="1.6"
                                                 FillOpacity="0.18" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ThroughputPeakText}" Style="{StaticResource MutedTextStyle}"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="buffer pool · 32 KiB rings"
                                   Style="{StaticResource MonoTextStyle}" FontSize="10"
                                   Margin="0,0,16,0" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding StateLabel}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="10"
                                   Foreground="{Binding Session.State, Converter={StaticResource StateBrush}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Latency history -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LATENCY TRACE" Style="{StaticResource EyebrowStyle}"
                               Margin="0,0,0,12" />

                    <controls:SparklineChart Grid.Row="1" MinHeight="70"
                                             Values="{Binding LatencyHistory}"
                                             Stroke="{StaticResource AmberBrush}"
                                             StrokeThickness="2" />

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROBE LOSS" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                            <TextBlock Text="{Binding ProbeLossText}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="14" Margin="0,4,0,0"
                                       Foreground="{StaticResource AmberBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RECONNECTS" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                            <TextBlock Text="{Binding ReconnectsText}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="14" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ACTIVITY + SESSION ROW ====================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Recent activity -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource EyebrowStyle}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"
                                Padding="10,4" FontSize="10"
                                Command="{Binding Session.ConnectCommand}"
                                Content="OPEN CHANNEL" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelTag}"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryText}"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                   Style="{StaticResource MonoTextStyle}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Session card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="SESSION" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource StatusPillStyle}" Padding="8,2" Margin="10,0,0,0"
                                Background="#1414141E"
                                BorderBrush="{Binding Session.State, Converter={StaticResource StateBrush}}">
                            <TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="Bold"
                                       Foreground="{Binding Session.State, Converter={StaticResource StateBrush}}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="uptime" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                            <TextBlock Grid.Column="1" Text="{Binding UptimeText}"
                                       Style="{StaticResource MonoTextStyle}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="dropped frames" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                            <TextBlock Grid.Column="1" Text="{Binding DroppedText}"
                                       Style="{StaticResource MonoTextStyle}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="state" Style="{StaticResource MutedTextStyle}" FontSize="10.5" />
                            <TextBlock Grid.Column="1" Text="{Binding StateDetail}"
                                       Style="{StaticResource MonoTextStyle}" FontSize="10"
                                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Border Style="{StaticResource DividerStyle}" Margin="0,8,0,10" />

                        <TextBlock Text="ENDPOINT" Style="{StaticResource EyebrowStyle}" FontSize="9" />
                        <TextBlock Text="{Binding EndpointText}"
                                   Style="{StaticResource MonoTextStyle}" FontSize="10.5"
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource CyanBrush}" />

                        <TextBlock Text="TRANSFORM KEY" Style="{StaticResource EyebrowStyle}" FontSize="9"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Session.Settings.CryptoKey}" Style="{StaticResource MonoTextStyle}"
                                   FontSize="10.5" Margin="0,5,0,0"
                                   Foreground="{StaticResource PurpleBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

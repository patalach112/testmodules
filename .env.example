# Copy to .env and fill in. .env is git-ignored.

# Token issued by `cloudflared tunnel create` / the Zero Trust dashboard.
# Only required for the optional cloudflared compose profile.
CLOUDFLARE_TUNNEL_TOKEN=

# 64-bit XOR key for the asm_crypto transform, decimal or 0x hexadecimal.
ASM_CRYPTO_KEY=0x0123456789ABCDEF
